PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
NODE_ENV=production

# Extra allowed browser origins, comma separated
# CORS_ORIGINS=

# ---- Razorpay (Dashboard -> Account & Settings -> API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL https://<host>/api/payments/webhook,
# events payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---- Shipping charge (defaults match the storefront cart)
# FREE_SHIPPING_THRESHOLD=2499
# SHIPPING_FLAT=99

# ---- Shiprocket (leave blank to ship by hand from the admin)
# Shiprocket panel -> Settings -> API -> Configure -> Create an API user.
# Use that API user's email/password, not your login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact name of the pickup address in Shiprocket -> Settings -> Pickup addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# true = push every confirmed order to Shiprocket, assign AWB, book pickup
SHIPROCKET_AUTO_SHIP=false
# Shiprocket -> Settings -> API -> Webhooks: URL https://<host>/api/shipping/webhook
# and this same value as the token (sent back in the x-api-key header)
SHIPROCKET_WEBHOOK_TOKEN=
# Default parcel, cm and kg
# SHIPROCKET_PACKAGE_LENGTH=20
# SHIPROCKET_PACKAGE_BREADTH=15
# SHIPROCKET_PACKAGE_HEIGHT=10
# SHIPROCKET_PACKAGE_WEIGHT=0.5
